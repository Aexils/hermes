DATABASE_URL=postgresql+asyncpg://hermes:changeme@postgres:5432/hermes
REDIS_URL=redis://redis:6379/0

# Ollama — si sur une autre machine du réseau : http://192.168.x.x:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b

POSTGRES_PASSWORD=changeme

# Booklore — source principale de progression et d'EPUBs
BOOKLORE_API=http://booklore:6060
BOOKLORE_REFRESH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Path du dossier bookdrop monté dans le container Hermes
BOOKS_PATH=/books
# Équivalent Windows : C:\Users\alexi\Desktop\booklore\bookdrop
# Dans docker-compose : volumes: - C:\Users\alexi\Desktop\booklore\bookdrop:/books:ro

# Audiobookshelf — livres audio + transcription Whisper
AUDIOBOOKSHELF_API=http://audiobookshelf:13378
AUDIOBOOKSHELF_TOKEN=         # Générer dans ABS → Settings → Users → ton compte → API Token
AUDIOBOOKS_PATH=/audiobooks   # Chemin dans le container (monté ci-dessous)
AUDIOBOOKS_HOST_PATH=C:\Users\alexi\Desktop\audiobooks  # Chemin Windows vers ta librairie ABS
WHISPER_MODEL=medium           # GPU : medium ou large-v3 / CPU : base
